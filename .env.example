# Minimal required .env for Docker deployment
POSTGRES_PASSWORD=change_me_postgres_password
AUTH_SECRET=change_me_auth_secret
MEILISEARCH_API_KEY=change_me_meilisearch_master_key
REDIS_PASSWORD=change_me_redis_password

# Optional: set this to the URL users open in their browser.
# NEXTAUTH_URL=http://localhost:3000

# Optional: GitHub OAuth for one-click token binding
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
